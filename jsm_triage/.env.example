# ============================================================
# JSM AI Triage Tool – Environment Variables
# Copy this file to jsm_triage/.env and fill in your values.
# Never commit .env to source control.
# ============================================================

# -------------------------------------------------------
# ATLASSIAN JSM
# -------------------------------------------------------

# Your Atlassian Cloud domain (required)
ATLASSIAN_DOMAIN=your-org.atlassian.net

# --- Option A: OAuth 2.0 3LO (recommended for enterprise) ---
# Create an OAuth 2.0 app at https://developer.atlassian.com/console/myapps/
# Set callback URL to: http://localhost:8765/callback
# Grant scopes: read:jira-work write:jira-work read:servicedesk-request write:servicedesk-request offline_access
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
# Optional: override default redirect URI or scopes
# ATLASSIAN_REDIRECT_URI=http://localhost:8765/callback
# ATLASSIAN_SCOPES=read:jira-work write:jira-work read:servicedesk-request write:servicedesk-request offline_access

# --- Option B: Basic auth (API token) ---
# Generate token at: https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_EMAIL=you@example.com
ATLASSIAN_API_TOKEN=

# -------------------------------------------------------
# AZURE OPENAI
# -------------------------------------------------------

# Required for Azure OpenAI provider
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# --- Option A: API Key ---
AZURE_OPENAI_API_KEY=

# --- Option B: Entra ID / DefaultAzureCredential (run az login or use Managed Identity) ---
# Leave AZURE_OPENAI_API_KEY unset – DefaultAzureCredential is used automatically

# --- Option C: MSAL device flow 3LO (interactive, no az CLI needed) ---
# Register an app at https://portal.azure.com → Azure Active Directory → App Registrations
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
# AZURE_CLIENT_SECRET=   # optional, leave blank for public client device flow
# AZURE_SCOPES=https://cognitiveservices.azure.com/.default

# -------------------------------------------------------
# GITHUB COPILOT (GitHub Models)
# -------------------------------------------------------

# --- Option A: OAuth 3LO device flow ---
# Create OAuth App at https://github.com/settings/developers (enable Device Flow)
GITHUB_CLIENT_ID=
# GITHUB_SCOPES=read:user

# --- Option B: Personal Access Token ---
GITHUB_TOKEN=

# Model selection (any model on github.com/marketplace/models)
# GITHUB_MODEL=gpt-4o

# -------------------------------------------------------
# MICROSOFT COPILOT (Azure AI Inference / AI Foundry)
# -------------------------------------------------------

MS_COPILOT_ENDPOINT=https://your-project.inference.ai.azure.com
# MS_COPILOT_MODEL=gpt-4o
# MS_COPILOT_API_KEY=    # leave blank to use DefaultAzureCredential

# -------------------------------------------------------
# OPENAI (ChatGPT)
# -------------------------------------------------------

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OPENAI_ORG_ID=
# OPENAI_PROJECT_ID=
# OPENAI_BASE_URL=   # override for OpenAI-compatible APIs (e.g. local Ollama)

# -------------------------------------------------------
# ATLASSIAN ROVO
# -------------------------------------------------------
# Uses the same ATLASSIAN_* credentials above.
# Optionally specify a custom Rovo agent:
# ROVO_AGENT_ID=

# -------------------------------------------------------
# TRIAGE ENGINE
# -------------------------------------------------------

# Provider order (comma-separated, first available is used)
# TRIAGE_PROVIDER_ORDER=azure_openai,github_copilot,openai,ms_copilot,rovo

# Free-text org context injected into every triage prompt
# TRIAGE_ORG_CONTEXT=We are a 500-person SaaS company. IT team includes L1 (helpdesk), L2 (sysadmin), L3 (security). VIP users: executives in the "Leadership" Jira group.
